    <!-- Sound cues (v32, v33): themes, nature sounds, a separate sound for each event, working alongside another screen reader -->

    <!-- Entry point on the main Settings screen -->
    <string name="pref_open_sounds">Sound cue settings (theme, nature sounds, volume)</string>
    <string name="pref_open_sounds_summary">Water drops, rain, birds, footsteps, iPhone-style sounds and other relaxing sounds; a separate sound for each event; also works alongside another screen reader</string>

    <!-- Sound cues screen -->
    <string name="snd_title">Sound cues</string>
    <string name="snd_cat_main">Sound cues</string>
    <string name="snd_earcons_summary">A short sound without speech when focus changes, on click, at the edge of a list, when the window changes, on scroll and on error. Off by default.</string>
    <string name="snd_theme">Sound theme</string>
    <string name="snd_volume">Cue volume (percent)</string>
    <string name="snd_volume_summary">Works together with the phone\'s accessibility volume</string>
    <string name="snd_volume_exact">Enter the volume as an exact number</string>
    <string name="snd_volume_exact_summary">Now: %1$d percent</string>
    <string name="snd_demo">Play all cues one after another</string>
    <string name="snd_demo_summary">The focus, click, edge, window, scroll and error sounds play one by one</string>

    <!-- Preferred engine: cues while TalkBack is on -->
    <string name="snd_cat_standby">Preferred engine: alongside another screen reader</string>
    <string name="snd_standby">Play cues while TalkBack is on</string>
    <string name="snd_standby_summary">When O‘zbegim is the preferred speech engine and TalkBack or another screen reader reads the screen, the focus, click, window and scroll cues still play. For this, the O‘zbegim accessibility service must stay turned on.</string>
    <string name="snd_standby_status_title">Status</string>
    <string name="snd_status_master_off">Sound cues are off: turn on the Sound cues switch above.</string>
    <string name="snd_status_off">This switch is off: no cues play while TalkBack or another screen reader is on.</string>
    <string name="snd_status_no_service">The O‘zbegim accessibility service is not turned on. Turn on O‘zbegim in your phone\'s Accessibility settings, then cues will play while TalkBack is on.</string>
    <string name="snd_status_ready">Ready: while another screen reader is on, the focus, click, window and scroll cues play. Edge and error cues play only when O‘zbegim itself is reading. If you hear every cue twice, turn off Sound feedback in the TalkBack settings.</string>

